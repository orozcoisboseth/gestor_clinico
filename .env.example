# GEMINI_API_KEY: Clave de Google Gen AI. Inyectada automáticamente en AI Studio o configurada manualmente.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Modelo configurado para procesamiento de notas clínicas (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# GEMINI_BASE_URL: URL base opcional para el cliente de Google Gen AI
GEMINI_BASE_URL=""

# TURSO / LibSQL Configuración:
# Para usar Turso remoto en la nube, especifica la URL libsql://... y el token.
# Si se deja vacío o file:local.db, se utiliza SQLite local embebido mediante @libsql/client.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# SMTP de Google para envío de correos (recuperación de contraseña, facturas, citas):
# Utiliza contraseña de aplicación de 16 caracteres de Google (App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Consultorio Psicológico <notificaciones@consultorio.com>"

# JWT Secret para sesiones seguras
JWT_SECRET="psicogestion_secure_jwt_token_key_2025"

# Puerto del servidor
PORT="3000"
